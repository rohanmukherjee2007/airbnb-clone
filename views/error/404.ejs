<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 Page Not Found - Airbnb</title>
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.2.0/css/all.min.css"
        integrity="sha512-nMJjQudb6RMMr08oY6YSfNlEWl1l8XWuoOwNvtWXrrgVs8MCR8AZBB1tEAO+ogiI93gXtG1XPmg+bAP5DochSA=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
        rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/404.css" />
</head>
<body>
    <div class="error-page">
        <a href="/" class="error-logo">
            <i class="fa-regular fa-compass"></i>
            <span>airbnb</span>
        </a>

        <div class="error-content">
            <div class="error-text">
                <h1 class="error-title">Oops!</h1>
                <h2 class="error-subtitle">We can't seem to find the page you're looking for.</h2>
                <h6 class="error-code">Error code: 404</h6>

                <ul class="error-links">
                    <li>Here are some helpful links instead:</li>
                    <li><a href="/listings">All Listings</a></li>
                    <li><a href="/listings/new">Create a Listing</a></li>
                </ul>
            </div>

            <svg class="error-art" viewBox="0 0 300 420" aria-hidden="true">
                <!-- Ground -->
                <ellipse cx="110" cy="405" rx="100" ry="10" fill="#e4e4e4" />
                <path d="M212 404 Q222 394 240 398 Q262 396 268 404 Q262 413 240 412 Q220 415 212 404 Z" fill="#ff5a6e" />
                <circle cx="278" cy="412" r="3.5" fill="#ff5a6e" />
                <circle cx="230" cy="418" r="2.5" fill="#ff5a6e" />

                <!-- Legs and shoes -->
                <rect x="88" y="305" width="15" height="85" fill="#fbb59a" />
                <rect x="117" y="305" width="15" height="85" fill="#fbb59a" />
                <rect x="88" y="305" width="15" height="30" fill="#7b1a4e" />
                <rect x="117" y="305" width="15" height="30" fill="#7b1a4e" />
                <rect x="80" y="384" width="28" height="13" rx="6" fill="#127f8b" />
                <rect x="112" y="384" width="28" height="13" rx="6" fill="#127f8b" />
                <path d="M92 384 q-4 -6 0 -7 q4 1 0 7 M124 384 q-4 -6 0 -7 q4 1 0 7" fill="none" stroke="#ff8a8a" stroke-width="1.5" />

                <!-- Left arm -->
                <rect x="48" y="212" width="14" height="82" rx="7" fill="#fbb59a" />
                <circle cx="55" cy="296" r="9" fill="#fbb59a" />

                <!-- Neck and dress -->
                <rect x="101" y="168" width="18" height="16" fill="#fbb59a" />
                <rect x="60" y="178" width="100" height="135" rx="10" fill="#1fd1c1" />
                <rect x="52" y="180" width="20" height="44" rx="8" fill="#7b1a4e" />
                <rect x="148" y="180" width="20" height="44" rx="8" fill="#7b1a4e" />
                <rect x="60" y="248" width="100" height="14" fill="#7b1a4e" />
                <rect x="60" y="280" width="100" height="14" fill="#7b1a4e" />
                <circle cx="110" cy="200" r="5" fill="#7b1a4e" />
                <circle cx="110" cy="224" r="5" fill="#7b1a4e" />

                <!-- Right arm and ice cream cone -->
                <polyline points="158,218 162,262 186,250" fill="none" stroke="#fbb59a" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
                <polygon points="196,212 242,226 196,260" fill="#fcc419" />
                <circle cx="190" cy="248" r="9" fill="#fbb59a" />

                <!-- Bun, ears and head -->
                <circle cx="110" cy="38" r="26" fill="#127f8b" />
                <circle cx="46" cy="122" r="12" fill="#fbb59a" />
                <circle cx="174" cy="122" r="12" fill="#fbb59a" />
                <ellipse cx="110" cy="118" rx="62" ry="58" fill="#fbb59a" />
                <path d="M48 114 A62 58 0 0 1 172 114 Q150 96 110 100 Q70 96 48 114 Z" fill="#127f8b" />

                <!-- Bow -->
                <polygon points="60,76 76,88 62,100" fill="#fcc419" />
                <polygon points="92,76 76,88 90,100" fill="#fcc419" />

                <!-- Face -->
                <circle cx="90" cy="122" r="4" fill="#484848" />
                <circle cx="130" cy="122" r="4" fill="#484848" />
                <ellipse cx="76" cy="134" rx="9" ry="5" fill="#f78b8b" />
                <ellipse cx="144" cy="134" rx="9" ry="5" fill="#f78b8b" />
                <path d="M90 158 Q94 144 104 148 Q110 142 116 148 Q126 144 130 158 Q110 152 90 158 Z" fill="white" stroke="#484848" stroke-width="2" stroke-linejoin="round" />
            </svg>
        </div>
    </div>
</body>
</html>
