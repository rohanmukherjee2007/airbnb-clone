<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Airbnb: New Listing</title>
</head>
<body>
    <h2>Create New Listing</h2>
    <form method="POST" action="/listings">
        <label for="title">Title:&nbsp</label>
        <input id="title" name="title" placeholder="Enter Title"/><br/><br/>
        <label for="description">Description:&nbsp</label>
        <textarea id="description" name="description" placeholder="Enter Description"></textarea><br/><br/>
        <label for="image">Image URL:&nbsp</label>
        <input id="image" name="image" placeholder="Enter Image URL"/><br/><br/>
        <label for="price">Price:&nbsp</label>
        <input id="price" name="price" type="number" placeholder="Enter Price"/><br/><br/>
        <label for="location">Location:&nbsp</label>
        <input id="location" name="location" placeholder="Enter Location"/><br/><br/>
        <label for="country">Country:&nbsp</label>
        <input id="country" name="country" placeholder="Enter Country"/><br/><br/>
        <button type="submit">Create Listing</button>
    </form>
</body>
</html>