<% layout('/layouts/boilerplate') -%>
<form method="POST" action="/listings" novalidate class="needs-validation">
    <div class="row">
        <div class="col-8 offset-2">
            <h2>Create New Listing</h2>
            <div class="title-div mb-3">
                <label for="title" class="form-label">Title:&nbsp;</label>
                <input
                    id="title"
                    name="title"
                    placeholder="Enter Title"
                    class="form-control"
                    required
                />
                <div class="invalid-feedback">Please enter a title.</div>
            </div>
            <div class="desc-div mb-3">
                <label for="description" class="form-label"
                    >Description:&nbsp;</label
                >
                <textarea
                    id="description"
                    name="description"
                    placeholder="Enter Description"
                    class="form-control"
                ></textarea>
                <div class="invalid-feedback">Please enter a description.</div>
            </div>
            <div class="img-div mb-3">
                <label for="image" class="form-label">Image URL:&nbsp;</label>
                <input
                    id="image"
                    name="image"
                    placeholder="Enter Image URL"
                    class="form-control"
                    type="url"
                />
                <div class="invalid-feedback">Please enter a valid URL.</div>
            </div>
            <div class="row">
                <div class="price-div col-md-6 mb-3">
                    <label for="price" class="form-label">Price:&nbsp;</label>
                    <input
                        id="price"
                        name="price"
                        type="number"
                        placeholder="Enter Price"
                        class="form-control"
                        required
                        min="0"
                    />
                    <div class="invalid-feedback">
                        Please enter a price of 0 or more.
                    </div>
                </div>
                <div class="country-div col-md-6 mb-3">
                    <label for="country" class="form-label"
                        >Country:&nbsp;</label
                    >
                    <input
                        id="country"
                        name="country"
                        placeholder="Enter Country"
                        class="form-control"
                        required
                    />
                </div>
            </div>
            <div class="loc-div mb-3">
                <label for="location" class="form-label">Location:&nbsp;</label>
                <input
                    id="location"
                    name="location"
                    placeholder="Enter Location"
                    class="form-control"
                    required
                />
                <div class="invalid-feedback">Please enter a location.</div>
            </div>
            <button type="submit" class="btn brand-btn d-block mx-auto">
                Create Listing
            </button>
        </div>
    </div>
</form>
