<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Airbnb: Editing <%= listing.title %></title>
</head>
<body>
    <h2>Edit</h2>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <label for="title">Title:&nbsp</label>
        <input id="title" name="title" value="<%= listing.title %>"/><br/><br/>
        <label for="description">Description:&nbsp</label>
        <textarea id="description" name="description"><%= listing.description %></textarea><br/><br/>
        <label for="image">Image URL:&nbsp</label>
        <input id="image" name="image" value="<%= listing.image.url %>"/><br/><br/>
        <label for="price">Price:&nbsp</label>
        <input id="price" name="price" type="number" value="<%= listing.price %>"/><br/><br/>
        <label for="location">Location:&nbsp</label>
        <input id="location" name="location" value="<%= listing.location %>"/><br/><br/>
        <label for="country">Country:&nbsp</label>
        <input id="country" name="country" value="<%= listing.country %>"/><br/><br/>
        <button type="submit">Finish</button>
    </form>
</body>
</html>