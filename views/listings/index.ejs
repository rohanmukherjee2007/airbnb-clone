<% layout('/layouts/boilerplate') -%>

<div class="row row-cols-1 row-cols-sm-1 row-cols-md-2 row-cols-lg-3">
  <% for (const listing of allListings) { %>
  <a href="/listings/<%= listing._id %>" class="col listing-link">
    <div class="card">
      <img class="card-img-top" src="<%= listing.image.url %>" style="height: 20rem;" alt="<%= listing.image.filename %>">
      <div class="card-body">
        <h5 class="card-title fw-bold"><%= listing.title %></h5>
        <p class="card-text"><%= listing.price.toLocaleString("en-US") %> / night</p>
      </div>
      <div class="card-img-overlay"></div>
    </div>
  </a>
  <% } %>
</div>