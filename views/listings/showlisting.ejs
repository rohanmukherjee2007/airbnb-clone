<% layout('/layouts/boilerplate') -%>
<% block('scripts').append('<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js" defer></script>') %>
<% block('scripts').append('<script src="/modifylisting.js" defer></script>') %>
<a href="/listings/<%= listing._id %>/edit">Edit</a>
<button id="delete">Delete</button>
<ul>
    <li>Title: <%= listing.title %></li>
    <li>Description: <%= listing.description %></li>
    <li>Price: <%= listing.price.toLocaleString("en-US") %></li>
    <li>Location: <%= listing.location %></li>
    <li>Country: <%= listing.country %></li>
    <img src="<%= listing.image.url %>"/>
</ul>
