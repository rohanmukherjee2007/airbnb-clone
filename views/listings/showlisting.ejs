<% layout('/layouts/boilerplate') -%>
<% block('styles').append('<link rel="stylesheet" href="/css/show.css">') %>
<% block('scripts').append('<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js" defer></script>') %>
<% block('scripts').append('<script src="/js/deletelisting.js" defer></script>') %>
<div class="row">
    <div class="col-md-6 offset-md-3">
        <h2>Listing Details</h2>
        <div class="card show-card">
            <img
                class="card-img-top show-img"
                src="<%= listing.image.url %>"
                alt="<%= listing.image.filename %>"
            />
            <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b><br />
                    <%= listing.description %><br />
                    $<%= listing.price.toLocaleString("en-US") %><br />
                    <%= listing.location %><br />
                    <%= listing.country %>
                </p>
            </div>
        </div>
        <div class="show-btns">
            <a href="/listings/<%= listing._id %>/edit" class="btn brand-btn px-4">Edit</a>
            <button id="delete" class="btn btn-dark">Delete</button>
        </div>
    </div>
</div>
